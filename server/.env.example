# Postgres connection string (e.g. from a free Neon project).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password Mission Directors enter on the /admin page. Required — if
# unset, all admin actions (phase control, score edits, reset, CSV
# export) are refused by the server.
ADMIN_PASSWORD=change-me-before-deploying

# Set automatically by Render — no need to set this yourself.
# PORT=3001